# 根目录白名单：只允许以下内容，其他全部自动忽略
# 新建根目录文件或顶层目录时，须在下方追加对应 ! 规则，
# 并用 `git check-ignore -v <路径>` 自检（无输出 = 不会被忽略）
/*

# 允许的根目录文件
!/.gitignore
!/.cursorrules
!/.windsurfrules
!/CLAUDE.md
!/AGENTS.md
!/README.md
!/SETUP.md
!/OSS.md
!/overview.png

# 允许的顶层目录
!/foundation/
!/standards/
!/engineering/
!/testing/
!/versions/
# AI 操作面板的流程与协作规则
!/agents/
# 模板维护区（验证套件等），产品使用者可整目录删除
!/maintainer/
# 使用者提供的原始资料，只有清单入库
!/materials/

materials/*
!materials/README.md

# 研发工程代码不纳入驱动面板（所有工程 clone 到 engineering/workspace/<name>/）
engineering/workspace/*
!engineering/workspace/.gitkeep

# 测试工程代码不纳入驱动面板
testing/*/workspace/*
!testing/*/workspace/.gitkeep

# 测试证据外置（SOP-10）：版本和测试目录不入库截图、录屏、日志、压缩包、PDF，文档只记 URL
versions/**/*.png
versions/**/*.jp*g
versions/**/*.gif
versions/**/*.webp
versions/**/*.mp4
versions/**/*.mov
versions/**/*.webm
versions/**/*.zip
versions/**/*.gz
versions/**/*.har
versions/**/*.log
versions/**/*.pdf
testing/**/*.png
testing/**/*.jp*g
testing/**/*.gif
testing/**/*.webp
testing/**/*.mp4
testing/**/*.mov
testing/**/*.webm
testing/**/*.zip
testing/**/*.gz
testing/**/*.har
testing/**/*.log
testing/**/*.pdf

# 原型设计工程构建产物与依赖（不入 git）
foundation/design/prototype/dist/
foundation/design/prototype/node_modules/
