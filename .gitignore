# 研发工程代码不纳入驱动面板（所有工程 clone 到 engineering/workspace/<name>/）
engineering/workspace/*
!engineering/workspace/.gitkeep

# 测试工程代码不纳入驱动面板
testing/*/workspace/*
!testing/*/workspace/.gitkeep

# 统一原型工程：源码纳入面板，仅忽略依赖与构建产物
foundation/design/prototype/node_modules/
foundation/design/prototype/dist/
foundation/design/prototype/package-lock.json

# 可视化辅助工具临时文件
.superpowers/

# 操作系统生成文件
.DS_Store
.DS_Store?
Thumbs.db
desktop.ini

# 编辑器生成文件
.idea/
*.swp
*.swo
*~

# rclone 凭证文件（不入 git，只存在本机）
.rclone.conf
oss-credentials.conf
oss-secret.env
*.credentials

